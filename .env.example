PORT=3000
ORIGIN=http://localhost:3000
TOKEN_SECRET=TU_TOKEN_SECRETO_AQUI

# Prisma/PostgreSQL (runtime backend)
DATABASE_URL=prisma://TU_ACCELERATE_URL_O_CONNECTION_STRING

